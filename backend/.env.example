# Leo Infinity Trade Portal — backend environment template.
#
# Copy to `.env` for local development and fill in real values. NEVER commit a
# real `.env`. All variables are namespaced with the LEO_ prefix so the service
# never accidentally consumes generic host variables (DEBUG, HOST, PORT, ...).

# -- Application ------------------------------------------------------------
LEO_ENVIRONMENT=development        # development | test | staging | production
LEO_DEBUG=false
LEO_APP_NAME=Leo Infinity Trade Portal API
LEO_API_V1_PREFIX=/api/v1

# -- Server -----------------------------------------------------------------
LEO_HOST=0.0.0.0
LEO_PORT=8000

# -- Database (async DSN; asyncpg driver) -----------------------------------
LEO_DATABASE_URL=postgresql+asyncpg://leo:leo@localhost:5432/leo_portal
LEO_DB_POOL_SIZE=10
LEO_DB_MAX_OVERFLOW=20
LEO_DB_POOL_TIMEOUT=30
LEO_DB_ECHO=false

# -- Security / JWT ---------------------------------------------------------
# REQUIRED IN EVERY ENVIRONMENT (development included). The app fails to start
# if this is unset, empty, or a known placeholder value — there is no usable
# default. In staging/production it must also be >= 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (The placeholder below is intentionally rejected; replace it before starting.)
LEO_JWT_SECRET_KEY=change-me-generate-with-secrets-token_urlsafe-48
LEO_JWT_ALGORITHM=HS256
LEO_ACCESS_TOKEN_EXPIRE_MINUTES=15
LEO_REFRESH_TOKEN_EXPIRE_DAYS=14

# -- Proxy / client IP ------------------------------------------------------
# By default X-Forwarded-For is IGNORED and the direct socket peer is used as
# the client IP (so clients cannot spoof their audited IP). Enable ONLY when the
# app runs behind a trusted reverse proxy/load balancer that sets the header.
LEO_TRUST_FORWARDED_FOR=false
# Number of trusted proxy hops; the client IP is read from this position from
# the RIGHT of X-Forwarded-For. Only used when LEO_TRUST_FORWARDED_FOR=true.
LEO_TRUSTED_PROXY_HOPS=1

# -- Password / lockout policy ----------------------------------------------
LEO_PASSWORD_MIN_LENGTH=12
LEO_PASSWORD_MAX_LENGTH=128
LEO_MAX_FAILED_LOGIN_ATTEMPTS=3
LEO_TEMPORARY_PASSWORD_EXPIRE_MINUTES=60

# -- CORS (comma-separated or JSON array) -----------------------------------
LEO_CORS_ALLOW_ORIGINS=http://localhost:5173

# -- Locale reference data --------------------------------------------------
LEO_SUPPORTED_LANGUAGES=en,ar,fr,es,zh
LEO_SUPPORTED_CURRENCIES=AED,USD,EUR,GBP,INR,CNY
LEO_DEFAULT_TIMEZONE=UTC

# -- Logging ----------------------------------------------------------------
LEO_LOG_LEVEL=INFO
LEO_LOG_JSON=true

# -- Admin bootstrap (consumed by `python -m app.scripts.bootstrap_admin`) --
# These are read directly (no LEO_ prefix). Leave unset to be prompted.
# ADMIN_USERNAME=superadmin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_MUST_CHANGE_PASSWORD=false

# -- Test database (optional; enables PostgreSQL integration/concurrency tests)
# TEST_DATABASE_URL=postgresql+asyncpg://leo:leo@localhost:5432/leo_test
