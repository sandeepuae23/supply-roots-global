# ---------------------------------------------------------------------------
# Existing site — optional quote-delivery providers. The form still creates a
# reference and a buyer-initiated email/WhatsApp handoff when these are unset.
# ---------------------------------------------------------------------------
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
QUOTE_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Host port bindings. Defaults avoid ports commonly taken by other local
# stacks (3000 by other node apps, 5432 by a local Postgres install).
# ---------------------------------------------------------------------------
WEB_PORT=3100
API_PORT=8000
DB_PORT=5433

# ---------------------------------------------------------------------------
# Frontend — origin of the FastAPI backend used by the portal/auth API layer.
# The API client appends the versioned `/api/v1` prefix itself, so set this to
# the server ORIGIN only.
#
#   Local dev (separate API):   VITE_API_BASE_URL=http://localhost:8000
#   Same-origin production:     VITE_API_BASE_URL=
#
# Leaving it empty makes requests relative (`/api/v1/...`), which keeps the
# HttpOnly refresh cookie same-site.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Trade portal — only needed for the `portal` compose profile:
#   docker compose --profile portal up -d --build
# ---------------------------------------------------------------------------
# PostgreSQL service credentials (used to build LEO_DATABASE_URL below).
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal

# The backend reads LEO_-namespaced settings (app/core/config.py,
# env_prefix="LEO_"). These are the canonical names; compose passes them
# straight through to the api service.

# REQUIRED before starting the portal profile. Generate a fresh value per
# environment and never commit a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left empty on purpose (compose keeps the site-only default runnable); the
# backend settings validation fails closed at startup when this is unset.
LEO_JWT_SECRET_KEY=

# Short-lived access tokens, rotating refresh tokens (roadmap section 6).
LEO_ACCESS_TOKEN_EXPIRE_MINUTES=15
LEO_REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated browser origins allowed to call the API. Defaults to the
# site's host port (3100); change it in step with WEB_PORT.
LEO_CORS_ALLOW_ORIGINS=http://localhost:3100

LEO_ENVIRONMENT=development

# First-administrator bootstrap (roadmap section 17, step 3). Optional and
# idempotent: the backend entrypoint runs app/scripts/bootstrap_admin.py only
# when BOOTSTRAP_ADMIN=1. The password is consumed at bootstrap and only its
# Argon2id hash is stored. Leave BOOTSTRAP_ADMIN=0 to skip.
BOOTSTRAP_ADMIN=0
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
